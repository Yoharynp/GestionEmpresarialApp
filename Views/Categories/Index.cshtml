@model IEnumerable<GestionEmpresarialApp.Models.Category>
@{
    ViewData["Title"] = "Categorías";
    bool canCreate = ViewBag.CanCreate == true;
    bool canEdit   = ViewBag.CanEdit   == true;
    bool canDelete = ViewBag.CanDelete == true;
    var urlCreate  = Url.Action("Create") ?? "/Categories/Create";
    var urlEdit    = Url.Action("Edit")   ?? "/Categories/Edit";
}

<div class="page-top-row">
    <div class="page-header" style="margin-bottom: 0;">
        <div class="page-header-accent"></div>
        <h3>Gestión de Categorías</h3>
        <p>Organice el catálogo de productos por categoría</p>
    </div>
    <div style="display:flex; gap:0.75rem; align-items:center;">
        @if (canCreate)
        {
            <button type="button" class="btn-new" onclick="openForm()">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Nueva Categoría
            </button>
        }
    </div>
</div>

@if (ViewBag.FormError != null)
{
    <div class="form-error-banner">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
        </svg>
        @ViewBag.FormError
    </div>
}

<div class="inline-form-panel" id="inline-form" style="display:none;">
    <div class="form-panel">
        <div class="form-panel-top-accent"></div>
        <div class="form-panel-header">
            <h4 class="form-panel-title" id="form-title">Nueva Categoría</h4>
            <button type="button" class="btn-icon" onclick="closeForm()" title="Cerrar">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <form id="category-form" method="post" action="@urlCreate">
            @Html.AntiForgeryToken()
            <input type="hidden" id="form-category-id" name="CategoryId" value="0">

            <div class="form-grid" style="grid-template-columns: 1fr;">
                <div class="form-group">
                    <label for="field-name">Nombre *</label>
                    <input type="text" id="field-name" name="Name" placeholder="Nombre de la categoría">
                    <span class="field-error" id="err-name"></span>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-save" id="btn-submit">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 3H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V7l-4-4z" />
                    </svg>
                    <span id="btn-label">Crear Categoría</span>
                </button>
                <button type="button" class="btn-cancel" onclick="closeForm()">Cancelar</button>
            </div>
        </form>
    </div>
</div>

<div class="table-container" style="margin-top: 1.5rem;">
    <div class="table-toolbar">
        <div class="search-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
            </svg>
            <input type="text" id="search-categories" class="search-input" placeholder="Buscar categoría..." autocomplete="off">
        </div>
    </div>

    <table class="data-table" id="categories-table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Productos</th>
                @if (canEdit || canDelete)
                {
                    <th>Acciones</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var cat in Model)
            {
                var delUrl = Url.Action("Delete", new { id = cat.CategoryId });
                <tr>
                    <td>@cat.Name</td>
                    <td style="color:var(--gray-600);">@cat.Products.Count</td>
                    @if (canEdit || canDelete)
                    {
                        <td>
                            @if (canEdit)
                            {
                                <button type="button" class="btn-table-action edit" title="Editar"
                                    onclick="openEdit(@cat.CategoryId, '@cat.Name')">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125" />
                                    </svg>
                                </button>
                            }
                            @if (canDelete)
                            {
                                <form method="post" action="@delUrl" style="display:inline;"
                                      onsubmit="return confirm('¿Eliminar la categoría @cat.Name?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-table-action delete" title="Eliminar">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                                        </svg>
                                    </button>
                                </form>
                            }
                        </td>
                    }
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="3" style="text-align:center; padding:2rem; color:var(--gray-500);">Sin categorías para mostrar.</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="table-footer" id="categories-count">
        Mostrando @Model.Count() categorías
    </div>
</div>

@section Scripts {
    <script>
        wireTableSearch('search-categories', 'categories-table', 'categories-count', 'categorías');

        var formEl   = document.getElementById('inline-form');
        var formTag  = document.getElementById('category-form');
        var titleEl  = document.getElementById('form-title');
        var btnLabel = document.getElementById('btn-label');

        function openForm() {
            formTag.action = '@urlCreate';
            titleEl.textContent  = 'Nueva Categoría';
            btnLabel.textContent = 'Crear Categoría';
            document.getElementById('form-category-id').value = '0';
            document.getElementById('field-name').value       = '';
            clearErrors();
            showPanel();
        }

        function openEdit(id, name) {
            formTag.action = '@urlEdit';
            titleEl.textContent  = 'Editar Categoría';
            btnLabel.textContent = 'Guardar Cambios';
            document.getElementById('form-category-id').value = id;
            document.getElementById('field-name').value       = name;
            clearErrors();
            showPanel();
        }

        function showPanel() {
            formEl.style.display = 'block';
            formEl.classList.remove('panel-closing');
            formEl.classList.add('panel-open');
            formEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function closeForm() {
            formEl.classList.remove('panel-open');
            formEl.classList.add('panel-closing');
            setTimeout(function() {
                formEl.style.display = 'none';
                formEl.classList.remove('panel-closing');
            }, 350);
        }

        function clearErrors() {
            var el = document.getElementById('err-name');
            if (el) el.textContent = '';
            var f = document.getElementById('field-name');
            if (f) f.style.borderColor = '';
        }

        formTag.addEventListener('submit', function(e) {
            clearErrors();
            if (!document.getElementById('field-name').value.trim()) {
                var el = document.getElementById('err-name');
                var f  = document.getElementById('field-name');
                if (el) el.textContent = 'El nombre es requerido';
                if (f)  f.style.borderColor = 'var(--red-600)';
                e.preventDefault();
            }
        });

        @if (ViewBag.ShowForm == true)
        {
            <text>openForm();</text>
        }
    </script>
}
